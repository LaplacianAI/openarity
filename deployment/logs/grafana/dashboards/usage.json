    {
      "id": 23,
      "type": "timeseries",
      "title": "Reply delivery time",
      "description": "From an answer being written to the channel accepting it.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
