          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(sum(cached_input_tokens), 0) AS value FROM runs WHERE $__timeFilter(created_at) AND team_id IN ($team) AND agent_name IN ($agent)"
        }
