          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval, 0), agent_name AS metric, sum(input_tokens - cached_input_tokens + cached_input_tokens / 10 + output_tokens) AS value FROM runs WHERE $__timeFilter(created_at) AND team_id IN ($team) AND agent_name IN ($agent) GROUP BY 1, 2 ORDER BY 1"
