          "format": "table",
          "rawSql": "SELECT 100.0 * sum(cached_input_tokens) / nullif(sum(input_tokens), 0) AS value FROM runs WHERE $__timeFilter(created_at) AND team_id IN ($team) AND agent_name IN ($agent)"
        }
