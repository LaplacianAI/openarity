    {
      "id": 8,
      "type": "timeseries",
      "title": "Runs by status",
      "description": "Runs started in each interval, by how they ended (or that they have not).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval, 0), status AS metric, count(*) AS value FROM runs WHERE $__timeFilter(created_at) AND team_id IN ($team) AND agent_name IN ($agent) AND parent_run_id IS NULL GROUP BY 1, 2 ORDER BY 1"
