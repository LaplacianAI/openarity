    {
      "id": 14,
      "type": "table",
      "title": "Agents",
      "description": "Each agent over the range: how much it ran, failed and spent. Tokens count a cached token as a tenth; cache reads are shown whole beside them.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT agent_name AS \"Agent\", count(*) AS \"Runs\", count(*) FILTER (WHERE status = 'failed') AS \"Failed\", round(100.0 * count(*) FILTER (WHERE status = 'failed') / nullif(count(*) FILTER (WHERE status IN ('succeeded', 'failed', 'cancelled')), 0), 1) AS \"Failed %\", sum(input_tokens - cached_input_tokens + cached_input_tokens / 10 + output_tokens) AS \"Tokens\", sum(cached_input_tokens) AS \"Cache reads\", round(100.0 * sum(cached_input_tokens) / nullif(sum(input_tokens), 0), 1) AS \"Cache hit %\", round(avg(input_tokens - cached_input_tokens + cached_input_tokens / 10 + output_tokens)) AS \"Tokens per run\", round((percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM finished_at - started_at)))::numeric, 1) AS \"Median s\", max(created_at) AS \"Last run\" FROM runs WHERE $__timeFilter(created_at) AND team_id IN ($team) AND agent_name IN ($agent) GROUP BY agent_name ORDER BY \"Tokens\" DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Tokens",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 15,
      "type": "table",
      "title": "Teams",
      "description": "Each team over the range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT t.name AS \"Team\", count(*) AS \"Runs\", sum(r.input_tokens - r.cached_input_tokens + r.cached_input_tokens / 10 + r.output_tokens) AS \"Tokens\", sum(r.cached_input_tokens) AS \"Cache reads\" FROM runs r JOIN teams t ON t.id = r.team_id WHERE $__timeFilter(r.created_at) AND r.team_id IN ($team) AND r.agent_name IN ($agent) GROUP BY t.name ORDER BY \"Tokens\" DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Tokens",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 16,
      "type": "table",
      "title": "Recent failures",
      "description": "The last fifty runs that failed, newest first, with what they said.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT r.created_at AS \"When\", t.name AS \"Team\", r.agent_name AS \"Agent\", left(r.error, 300) AS \"Error\", r.id AS \"Run\" FROM runs r JOIN teams t ON t.id = r.team_id WHERE $__timeFilter(r.created_at) AND r.team_id IN ($team) AND r.agent_name IN ($agent) AND r.status = 'failed' ORDER BY r.created_at DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 17,
      "type": "table",
      "title": "Largest delegation trees",
      "description": "Runs that handed work to other agents: how many, how deep, and what the tree spent.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT root.created_at AS \"When\", root.agent_name AS \"Root agent\", count(r.id) - 1 AS \"Delegates\", max(r.depth) AS \"Depth\", sum(r.input_tokens - r.cached_input_tokens + r.cached_input_tokens / 10 + r.output_tokens) AS \"Tokens\", root.id AS \"Run\" FROM runs root JOIN runs r ON r.root_run_id = root.id WHERE $__timeFilter(root.created_at) AND root.team_id IN ($team) AND root.parent_run_id IS NULL GROUP BY root.id, root.created_at, root.agent_name HAVING count(r.id) > 1 ORDER BY \"Delegates\" DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Delegates",
            "desc": true
          }
        ]
      }
    },
