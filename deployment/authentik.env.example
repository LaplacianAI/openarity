# Copy to authentik.env and fill both in. Neither has a default on purpose:
# an identity provider with a shipped secret is worse than one that refuses to
# start.
#
#   openssl rand -base64 36   # once for each
#
AUTHENTIK_SECRET_KEY=
AUTHENTIK_PG_PASS=

# Uncomment to stop authentik sending crash reports to its authors.
# AUTHENTIK_ERROR_REPORTING__ENABLED=false
