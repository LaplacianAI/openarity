    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.14",
    "vitest": "^3.2.7"
