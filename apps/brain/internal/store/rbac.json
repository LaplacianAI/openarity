{
  "$comment": [
    "The permissions this software enforces, the roles it ships with, and which",
    "permission each route requires. Applied by `brain migrate up`.",
    "",
    "This file is the product's defaults, not the last word. The database is the",
    "source of truth at runtime, so an enterprise creating its own roles and",
    "granting them from a dashboard needs no deploy. The loader reflects that:",
    "",
    "  permissions  upserted. Never deleted \u2014 an enterprise may have granted",
    "               one, and the foreign key would refuse anyway.",
    "  roles        only the ones named here are touched. A role created by an",
    "               operator is never modified or removed.",
    "  routes       replaced wholesale. Routes come from code, so this file is",
    "               authoritative and a row for a route that no longer exists",
    "               is stale rather than someone's configuration.",
    "",
    "Startup compares the mux against `routes` and refuses to serve when a",
    "protected route has no entry. A missing mapping is a crash naming the",
    "route, never a silently open endpoint."
  ],
  "permissions": [
    {
      "name": "agent:write",
      "description": "Create and change agents"
    },
    {
      "name": "tool:write",
      "description": "Create and change tools"
    },
    {
      "name": "skill:write",
      "description": "Create and change skills"
    },
    {
      "name": "channel:read",
      "description": "See who is waiting to be approved on a team's channels"
    },
    {
      "name": "channel:write",
      "description": "Connect and configure channels"
    },
    {
      "name": "sender:approve",
      "description": "Let a waiting sender in, or remove one"
    },
    {
      "name": "session:read_all",
      "description": "Read every conversation in a team, including direct ones"
    },
    {
      "name": "membership:write",
      "description": "Add and remove team members"
    },
    {
      "name": "user:read",
      "description": "Look people up by name or subject"
    },
    {
      "name": "run:write",
      "description": "Start and cancel agent runs"
    },
    {
      "name": "team:settings",
      "description": "Change a team's settings: its model, web search and learning"
    }
  ],
  "roles": [
    {
      "name": "admin",
      "description": "Full access within a team, including membership",
      "permissions": [
        "agent:write",
        "tool:write",
        "skill:write",
        "channel:read",
        "channel:write",
        "sender:approve",
        "session:read_all",
        "membership:write",
        "user:read",
        "run:write",
        "team:settings"
      ]
    },
    {
      "name": "approver",
      "description": "Everything a member can do, and letting in the senders waiting on the team's channels",
      "permissions": [
        "agent:write",
        "skill:write",
        "tool:write",
        "run:write",
        "channel:read",
        "sender:approve"
      ]
    },
    {
      "name": "member",
      "description": "Create and change agents and tools within a team",
      "permissions": [
        "agent:write",
        "skill:write",
        "tool:write",
        "run:write"
      ]
    }
  ],
