node_modules/
dist/

# Tauri's build output and generated schemas
src-tauri/target/
src-tauri/gen/

# Generated by `make icons` from src-tauri/icons/icon.png, which is committed
# because it is the source the rest are derived from.
src-tauri/icons/*
!src-tauri/icons/icon.png

# The Go binaries the bundle ships, copied in by `make binaries`
src-tauri/binaries/

# Scratch used while rendering the icon
.iconsrv/
icon-source.html
public-icon.html
