{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Openarity",
  "version": "0.1.0",
  "identifier": "ai.laplacian.openarity.installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Openarity",
        "width": 720,
        "height": 640,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "deb"],
    "externalBin": ["binaries/oa"],
    "resources": [],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
