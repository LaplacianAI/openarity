vendor/
# Local secrets. deployment/authentik.env holds the identity provider's signing
# key and database password; the .example beside it is what belongs in git.
*.env
!*.env.example

# The 32-byte seal key and init-keys.json, which holds the recovery keys and
# the root token. Either one alone is a full compromise of every secret in
# OpenBao. See deployment/OPENBAO.md.
deployment/openbao/keys/

# Editor state, except the settings that belong to the project rather than to
# a person. .vscode/settings.json declares compose's !reset and !override
# tags, without which every contributor sees "Unresolved tag" on a file that
# is correct; extensions.json is a recommendation, not a preference.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Hugo
site/public/
site/resources/
site/.hugo_build.lock
site/_vendor/

# Playwright MCP scratch output. The screenshot tool writes into the working
# directory rather than the scratch folder, so the wildcard catches those too.
.playwright-mcp/
page-*.png
*-screenshot.png
signin.png

# The dashboard's dependencies and its build output.
#
# dist/ lands inside apps/brain because //go:embed cannot reach outside its own
# module. It is build output and is not committed — but the embed pattern must
# still match something or `go build ./...` fails on a fresh clone with
# "pattern all:dist: no matching files", which would make Node a requirement
# for compiling the brain. dist/.gitkeep is what keeps the directory tracked
# and empty; the handler serves a page saying so when index.html is missing.
apps/dashboard/node_modules/
apps/dashboard/dist/
apps/brain/internal/api/ui/dist/*
!apps/brain/internal/api/ui/dist/.gitkeep
